# Banking Integration Environment Variables

# Plaid Configuration (for bank connections)
REACT_APP_PLAID_CLIENT_ID=your_plaid_client_id_here
REACT_APP_PLAID_SECRET=your_plaid_secret_here
REACT_APP_PLAID_ENVIRONMENT=sandbox

# PayPal Configuration
REACT_APP_PAYPAL_CLIENT_ID=your_paypal_client_id_here
REACT_APP_PAYPAL_ENVIRONMENT=sandbox

# API Configuration
REACT_APP_API_BASE_URL=http://localhost:8080/api

# Security
REACT_APP_ENCRYPTION_KEY=your_encryption_key_here

# Instructions:
# 1. Copy this file to .env in the same directory
# 2. Replace placeholder values with your actual API keys
# 3. For Plaid: Sign up at https://plaid.com/developers/
# 4. For PayPal: Get credentials at https://developer.paypal.com/
# 5. Never commit .env file to version control